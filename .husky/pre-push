echo "Pre-push check: lockfile, lint, typecheck, tests"

# 1. The lockfile must match package.json
pnpm install --frozen-lockfile || {
  echo "The lockfile is out of sync. Run 'pnpm install' and commit pnpm-lock.yaml."
  exit 1
}

# 2. The same checks as the pull request check on GitHub
pnpm turbo run lint typecheck test || {
  echo "A check failed. Fix it before pushing (see the output above)."
  exit 1
}

echo "All checks passed."
