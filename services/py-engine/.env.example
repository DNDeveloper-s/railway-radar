# Copy this file to .env.local and change what you need.
# .env.local is ignored by git. Never put a real key in this file.

ENVIRONMENT=local
REDIS_URL=redis://localhost:6379/0
RAILKIT_BASE_URL=https://api.railkit.in
# Only fill this in if RailKit requires a key. Leave empty while you use the mock data.
RAILKIT_API_KEY=
# true means: never make a real call to RailKit
USE_MOCK_RAILKIT=true
# Comma-separated websites that may call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Redis data older than this many seconds is "stale"
TELEMETRY_STALE_AFTER_SECONDS=60
# Redis deletes a train after this many seconds
TELEMETRY_TTL_SECONDS=86400
# The worker fetches new data this often
INGEST_INTERVAL_SECONDS=600